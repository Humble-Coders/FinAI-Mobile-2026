<?xml version="1.0" encoding="utf-8"?>
<!--
  One full-bleed layer: the logo circle with its edge colours carried out to the
  corners, so no launcher mask shows a seam. The foreground is deliberately
  empty. Regenerate the PNGs from the PM's logo rather than editing them.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@android:color/transparent" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
